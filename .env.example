# Chomu Who? — Frontend Environment Configuration
# Copy to .env.local for local development.
# NEVER put SUPABASE_SERVICE_ROLE_KEY or LIVEKIT_API_SECRET in VITE_* variables!

# 'trystero' (default P2P fallback) or 'supabase' (Option B: Supabase + LiveKit)
VITE_MULTIPLAYER_BACKEND=trystero

# Required when VITE_MULTIPLAYER_BACKEND=supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
